<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Spotify Widget Preview</title>
    <style>
        body { font-family: system-ui, sans-serif; padding: 24px; background-color: #1a1a1a; color: #e0e0e0; }
        h1, h2 { color: #1DB954; }
        pre { background:#333; padding:12px; border-radius:6px; overflow-x: auto; margin-bottom: 16px;}
        .widget-container { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px; }
        .widget-item { border: 1px solid #444; border-radius: 8px; padding: 10px; background-color: #282828; }
        svg { display: block; }
    </style>
</head>
<body>
    <h1>Token généré et aperçu des widgets ✅</h1>

    <h2>Votre JWT:</h2>
    <pre><%= jwt %></pre>

    <h2>Snippets Markdown pour votre README:</h2>
    <pre><%= mdNow %></pre>
    <pre><%= mdTopTracks %></pre>
    <pre><%= mdRecent %></pre>
    <pre><%= mdTopArtists %></pre>
    <pre><%= mdStatus %></pre>
    <pre><%= mdProfile %></pre>

    <h2>Aperçu de vos widgets:</h2>
    <div class="widget-container">
        <div class="widget-item">
            <h3>Now Playing</h3>
            <%- nowPlayingSvg %>
        </div>
        <div class="widget-item">
            <h3>Top Tracks (4 semaines)</h3>
            <%- topTracksSvg %>
        </div>
        <div class="widget-item">
            <h3>Titres récemment écoutés</h3>
            <%- recentTracksSvg %>
        </div>
        <div class="widget-item">
            <h3>Top Artists</h3>
            <%- topArtistsSvg %>
        </div>
        <div class="widget-item">
            <h3>Current Status</h3>
            <%- currentStatusSvg %>
        </div>
        <div class="widget-item">
            <h3>Profile</h3>
            <%- profileSvg %>
        </div>
    </div>

    <p><strong>Important:</strong> Ce JWT expire dans <%= jwtExpiresIn %>. Tu pourras revenir sur <a href="/connect">/connect</a> pour régénérer un token.</p>
</body>
</html>