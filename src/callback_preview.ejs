<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Spotify Widget Preview</title>
    <style>
        body { font-family: system-ui, sans-serif; padding: 24px; background-color: #1a1a1a; color: #e0e0e0; }
        h1, h2 { color: #1DB954; }
        pre { background:#333; padding:12px; border-radius:6px; overflow-x: auto; margin-bottom: 8px;}
        .markdown-item, .widget-item {
            margin-bottom: 20px;
            padding: 10px;
            border: 1px solid #444;
            border-radius: 8px;
            background-color: #282828;
        }
        .widget-item h3 { margin-top: 0; color: #eee; }
        .widget-container { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px; }
        .copy-button {
            background-color: #1DB954;
            color: #fff;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.9em;
            margin-top: 5px;
            transition: background-color 0.3s ease;
        }
        .copy-button:hover {
            background-color: #1ED760;
        }
        svg { display: block; margin-top: 10px; }
        .copied-toast {
            visibility: hidden;
            min-width: 250px;
            margin-left: -125px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 16px;
            position: fixed;
            z-index: 1;
            left: 50%;
            bottom: 30px;
            font-size: 17px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        .copied-toast.show {
            visibility: visible;
            -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }
        @-webkit-keyframes fadein {
            from {bottom: 0; opacity: 0;}
            to {bottom: 30px; opacity: 1;}
        }
        @keyframes fadein {
            from {bottom: 0; opacity: 0;}
            to {bottom: 30px; opacity: 1;}
        }
        @-webkit-keyframes fadeout {
            from {bottom: 30px; opacity: 1;}
            to {bottom: 0; opacity: 0;}
        }
        @keyframes fadeout {
            from {bottom: 30px; opacity: 1;}
            to {bottom: 0; opacity: 0;}
        }
    </style>
</head>
<body>
    <h1>Token généré et aperçu des widgets ✅</h1>

    <h2>Votre JWT:</h2>
    <div class="markdown-item">
        <pre id="jwt-text"><%= jwt %></pre>
        <button class="copy-button" onclick="copyToClipboard('jwt-text')">Copier JWT</button>
    </div>

    <h2>Snippets Markdown pour votre README:</h2>
    <div class="markdown-item">
        <h3>Now Playing Markdown</h3>
        <pre id="md-now"><%= mdNow %></pre>
        <button class="copy-button" onclick="copyToClipboard('md-now')">Copier Markdown</button>
    </div>
    <div class="markdown-item">
        <h3>Top Tracks Markdown</h3>
        <pre id="md-top-tracks"><%= mdTopTracks %></pre>
        <button class="copy-button" onclick="copyToClipboard('md-top-tracks')">Copier Markdown</button>
    </div>
    <div class="markdown-item">
        <h3>Recent Tracks Markdown</h3>
        <pre id="md-recent"><%= mdRecent %></pre>
        <button class="copy-button" onclick="copyToClipboard('md-recent')">Copier Markdown</button>
    </div>
    <div class="markdown-item">
        <h3>Top Artists Markdown</h3>
        <pre id="md-top-artists"><%= mdTopArtists %></pre>
        <button class="copy-button" onclick="copyToClipboard('md-top-artists')">Copier Markdown</button>
    </div>
    <div class="markdown-item">
        <h3>Current Status Markdown</h3>
        <pre id="md-status"><%= mdStatus %></pre>
        <button class="copy-button" onclick="copyToClipboard('md-status')">Copier Markdown</button>
    </div>
    <div class="markdown-item">
        <h3>Profile Markdown</h3>
        <pre id="md-profile"><%= mdProfile %></pre>
        <button class="copy-button" onclick="copyToClipboard('md-profile')">Copier Markdown</button>
    </div>
    <div class="markdown-item">
        <h3>Listening Mosaic Markdown</h3>
        <pre id="md-mosaic"><%= mdMosaic %></pre>
        <button class="copy-button" onclick="copyToClipboard('md-mosaic')">Copier Markdown</button>
    </div>

    <h2>Aperçu de vos widgets:</h2>
    <div class="widget-container">
        <div class="widget-item">
            <h3>Now Playing</h3>
            <%- nowPlayingSvg %>
            <button class="copy-button" onclick="copyToClipboard(`https://<%= host %>/api/now-playing?jwt=<%= encodeURIComponent(jwt) %>`)">Copier Lien SVG</button>
        </div>
        <div class="widget-item">
            <h3>Top Tracks (4 semaines)</h3>
            <%- topTracksSvg %>
            <button class="copy-button" onclick="copyToClipboard(`https://<%= host %>/api/top-tracks?jwt=<%= encodeURIComponent(jwt) %>`)">Copier Lien SVG</button>
        </div>
        <div class="widget-item">
            <h3>Titres récemment écoutés</h3>
            <%- recentTracksSvg %>
            <button class="copy-button" onclick="copyToClipboard(`https://<%= host %>/api/recent-tracks?jwt=<%= encodeURIComponent(jwt) %>`)">Copier Lien SVG</button>
        </div>
        <div class="widget-item">
            <h3>Top Artists</h3>
            <%- topArtistsSvg %>
            <button class="copy-button" onclick="copyToClipboard(`https://<%= host %>/api/top-artists?jwt=<%= encodeURIComponent(jwt) %>`)">Copier Lien SVG</button>
        </div>
        <div class="widget-item">
            <h3>Current Status</h3>
            <%- currentStatusSvg %>
            <button class="copy-button" onclick="copyToClipboard(`https://<%= host %>/api/current-status?jwt=<%= encodeURIComponent(jwt) %>`)">Copier Lien SVG</button>
        </div>
        <div class="widget-item">
            <h3>Profile</h3>
            <%- profileSvg %>
            <button class="copy-button" onclick="copyToClipboard(`https://<%= host %>/api/profile?jwt=<%= encodeURIComponent(jwt) %>`)">Copier Lien SVG</button>
        </div>
    </div>
    
    <div class="markdown-item">
        <h3>Listening Mosaic</h3>
        <%- listeningMosaicSvg %>
        <button class="copy-button" onclick="copyToClipboard(`https://<%= host %>/api/listening-mosaic?jwt=<%= encodeURIComponent(jwt) %>`)">Copier Lien SVG</button>
    </div>

    <p><strong>Important:</strong> Ce JWT expire dans <%= jwtExpiresIn %>. Tu pourras revenir sur <a href="/">/</a> pour régénérer un token.</p>

    <div id="copiedToast" class="copied-toast">Copié !</div>

    <script>
        function copyToClipboard(textOrId) {
            let contentToCopy;
            if (document.getElementById(textOrId)) {
                contentToCopy = document.getElementById(textOrId).innerText;
            } else {
                contentToCopy = textOrId; // It's already the text (SVG URL)
            }

            navigator.clipboard.writeText(contentToCopy).then(() => {
                let toast = document.getElementById("copiedToast");
                toast.className = "copied-toast show";
                setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 3000);
            }).catch(err => {
                console.error('Failed to copy: ', err);
            });
        }
    </script>
</body>
</html>