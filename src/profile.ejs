<?xml version="1.0" encoding="UTF-8"?>
<svg width="<%= width %>" height="<%= height %>" viewBox="0 0 <%= width %> <%= height %>" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Spotify Profile">
  <title>Spotify Profile</title>
  
  <% if (gradient_bg) { %>
    <defs>
      <linearGradient id="bgGradient" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="<%= gradient_start_color %>" />
        <stop offset="100%" stop-color="<%= gradient_end_color %>" />
      </linearGradient>
    </defs>
  <% } %>
  <rect x="0" y="0" width="<%= width %>" height="<%= height %>" fill="<%= bgFill %>" rx="<%= border_radius %>" />

  <% if (hasImage) { %>
    <defs>
      <clipPath id="clipCircle">
        <circle cx="50" cy="50" r="40" />
      </clipPath>
    </defs>
    <image x="10" y="10" width="80" height="80" href="data:image/jpeg;base64,<%= imageAsB64 %>" clip-path="url(#clipCircle)" />
  <% } %>

  <text x="<%= textX %>" y="35" fill="<%= text_color %>" font-size="20" font-family="system-ui, sans-serif" font-weight="700"><%= name %></text>
  
  <% if (show_followers) { %>
    <text x="<%= textX %>" y="60" fill="<%= subtext_color %>" font-size="14" font-family="system-ui, sans-serif">Followers: <%= followers %></text>
  <% } %>
  
  <% if (show_id) { %>
    <text x="<%= textX %>" y="80" fill="<%= subtext_color %>" font-size="12" font-family="system-ui, sans-serif">ID: <%= profileId %></text>
  <% } %>

  <% if (topArtists.length > 0) { %>
    <text x="16" y="125" fill="<%= title_color %>" font-size="16" font-family="system-ui, sans-serif" font-weight="600">Top 3 Artistes (ce mois)</text>

    <% topArtists.forEach((artist, index) => { 
        const startY = 145;
        const rowHeight = 50;
        const imgSize = 40;
        const currentY = startY + (index * rowHeight);
        const textY = currentY + 25;
    %>
      
      <% if (artist.imageB64) { %>
        <defs>
          <clipPath id="clipArtist<%= index %>">
            <circle cx="<%= 36 %>" cy="<%= currentY + 20 %>" r="20" />
          </clipPath>
        </defs>
        <image x="16" y="<%= currentY %>" width="<%= imgSize %>" height="<%= imgSize %>" 
               href="data:image/jpeg;base64,<%= artist.imageB64 %>" 
               clip-path="url(#clipArtist<%= index %>)" />
      <% } %>

      <text x="70" y="<%= textY %>" fill="<%= subtext_color %>" font-size="14" font-family="system-ui, sans-serif" font-weight="500">
        <%= index + 1 %>. <%= artist.name %>
      </text>
    <% }) %>
  <% } %>

  <% if (topTracks.length > 0) { %>
    <text x="16" y="320" fill="<%= title_color %>" font-size="16" font-family="system-ui, sans-serif" font-weight="600">Top 5 Musiques du mois</text>

    <% topTracks.forEach((track, index) => { 
        const startY = 340;
        const rowHeight = 28;
        const imgSize = 20;
        const currentY = startY + (index * rowHeight);
        const textY = currentY + 15;
    %>
      
      <% if (track.imageB64) { %>
        <defs>
          <clipPath id="clipTrack<%= index %>">
            <rect x="16" y="<%= currentY %>" width="<%= imgSize %>" height="<%= imgSize %>" rx="4" />
          </clipPath>
        </defs>
        <image x="16" y="<%= currentY %>" width="<%= imgSize %>" height="<%= imgSize %>" 
               href="data:image/jpeg;base64,<%= track.imageB64 %>" 
               clip-path="url(#clipTrack<%= index %>)" />
      <% } %>

      <text x="45" y="<%= textY %>" fill="<%= subtext_color %>" font-size="12" font-family="system-ui, sans-serif">
        <tspan font-weight="500"><%= index + 1 %>. <%= track.name %></tspan>
        <tspan fill-opacity="0.8" dx="8"> • <%= track.artist %></tspan>
      </text>
    <% }) %>
  <% } %>
  
</svg>